APP_NAME=TheaterLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=theaterlink
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@theaterlink.test"
MAIL_FROM_NAME="${APP_NAME}"

SECURITY_ENABLED=false
SECURITY_API_KEY=false
SECURITY_TIMESTAMP=false
SECURITY_SIGNATURE=false
SECURITY_RATE_LIMIT=true
SECURITY_RATE_MAX=120
SECURITY_RATE_DECAY=1

OTP_EXPIRY_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

THEATERLINK_FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=/api/v1
VITE_API_TOKEN=
THEATERLINK_RESERVATION_HOLD_MINUTES=2880
THEATERLINK_GROUP_CANCEL_CUTOFF_HOURS=24
THEATERLINK_SLOT_HORIZON_DAYS=90
THEATERLINK_BOOKING_LEAD_MINUTES=60
THEATERLINK_BOOKING_CANCEL_CUTOFF_HOURS=24
THEATERLINK_CURRENCY=SAR
